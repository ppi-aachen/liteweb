---
export interface Props {
  prefix?: string;
}

const { prefix = '/' } = Astro.props;
const logoSrc = `${prefix}logo.png`.replace(/\/+/g, '/');
---

<!-- Mobile Menu Button -->
<button
  id="mobile-menu-btn"
  class="fixed top-4 left-4 z-50 desktop:hidden bg-dark text-white p-2 rounded"
  aria-label="Toggle menu"
>
  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- Top Navigation Bar (Desktop) -->
<nav
  class="hidden desktop:flex desktop:fixed desktop:top-0 desktop:left-0 desktop:right-0 desktop:bg-white desktop:z-40 desktop:shadow-md h-12"
  role="navigation"
>
  <div class="w-full flex items-center justify-between px-8">
    <!-- Logo (Left) -->
    <div class="flex items-center flex-shrink-0">
      <a href={`${prefix}index.html`.replace(/\/+/g, '/')} class="flex items-center h-full py-2">
        <img
          src={logoSrc}
          alt="PPI Aachen"
          class="h-10 object-contain"
          onerror="this.style.display='none'; const text=document.createElement('span'); text.className='logo-text text-dark text-xl font-light'; text.textContent='PPI Aachen'; this.parentElement.appendChild(text);"
        />
      </a>
    </div>

    <!-- Nav items + Language Switcher (Right) -->
    <div class="flex items-center flex-shrink-0">
      <div class="flex items-center space-x-1 flex-shrink-0">
        <!-- Beranda -->
        <a
          href={`${prefix}index.html`.replace(/\/+/g, '/')}
          class="nav-link px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light font-light"
          data-path="index.html"
        >
          <span data-lang-id="Beranda" data-lang-en="Home" data-lang-de="Startseite">Beranda</span>
        </a>
        <!-- Lapor Diri -->
        <a
          href={`${prefix}lapor-diri.html`.replace(/\/+/g, '/')}
          class="nav-link px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light font-light"
          data-path="lapor-diri.html"
        >
          <span data-lang-id="Lapor Diri" data-lang-en="Lapor Diri" data-lang-de="Lapor Diri">Lapor Diri</span>
        </a>
        <!-- Kegiatan -->
        <a
          href={`${prefix}events.html`.replace(/\/+/g, '/')}
          class="nav-link px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light font-light"
          data-path="events.html"
        >
          <span data-lang-id="Kegiatan" data-lang-en="Events" data-lang-de="Veranstaltungen">Kegiatan</span>
        </a>
        <!-- Komunitas -->
        <a
          href={`${prefix}communities.html`.replace(/\/+/g, '/')}
          class="nav-link px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light font-light"
          data-path="communities.html"
        >
          <span data-lang-id="Komunitas" data-lang-en="Communities" data-lang-de="Gemeinschaften">Komunitas</span>
        </a>
        <!-- Merchandise -->
        <a
          href={`${prefix}merchandise.html`.replace(/\/+/g, '/')}
          class="nav-link px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light font-light"
          data-path="merchandise.html"
        >
          <span data-lang-id="Merchandise" data-lang-en="Merchandise" data-lang-de="Merchandise">Merchandise</span>
        </a>

        <!-- Dropdown Organisasi -->
        <div class="relative group dropdown-container">
          <button
            class="dropdown-btn px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light flex items-center gap-1 font-light"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span data-lang-id="Organisasi" data-lang-en="Organization" data-lang-de="Organisation">Organisasi</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            class="dropdown-menu absolute hidden group-hover:block top-full left-0 bg-white shadow-lg min-w-[200px] py-2 z-50 border border-gray-100"
          >
            <a
              href={`${prefix}organization/sejarah.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/sejarah.html"
            >
              <span data-lang-id="Sejarah" data-lang-en="History" data-lang-de="Geschichte">Sejarah</span>
            </a>
            <a
              href={`${prefix}organization/kepengurusan.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/kepengurusan.html"
            >
              <span data-lang-id="Kepengurusan" data-lang-en="Current Board" data-lang-de="Vorstand">Kepengurusan</span>
            </a>
            <a
              href={`${prefix}organization/ad-art.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/ad-art.html"
            >
              <span data-lang-id="AD/ART PPI Aachen" data-lang-en="Bylaws" data-lang-de="Satzung">AD/ART PPI Aachen</span>
            </a>
            <a
              href={`${prefix}organization/spa.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/spa.html"
            >
              <span data-lang-id="SPA PPI Aachen" data-lang-en="General Assembly" data-lang-de="Mitgliedsversammlung">SPA PPI Aachen</span>
            </a>
            <a
              href={`${prefix}organization/arsip-lpj.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/arsip-lpj.html"
            >
              <span data-lang-id="Arsip LPJ" data-lang-en="Annual Report Archive" data-lang-de="Jahresberichtarchiv">Arsip LPJ</span>
            </a>
            <a
              href={`${prefix}organization/arsip-pengurus.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/arsip-pengurus.html"
            >
              <span data-lang-id="Arsip Pengurus" data-lang-en="Board Archive" data-lang-de="Vorstandsarchiv">Arsip Pengurus</span>
            </a>
            <a
              href={`${prefix}organization/kontak-email.html`.replace(/\/+/g, '/')}
              class="nav-link block px-4 py-2 text-dark text-[11pt] transition-colors duration-200 hover:bg-primary/20 hover:text-primary-light font-light"
              data-path="organization/kontak-email.html"
            >
              <span data-lang-id="Kontak" data-lang-en="Contact" data-lang-de="Kontakt">Kontak</span>
            </a>
          </div>
        </div>

        <!-- Dropdown Lainnya -->
