          <button
            class="dropdown-btn px-2 py-2 text-dark text-[12pt] transition-colors duration-200 hover:text-primary-light flex items-center gap-1 font-light"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span data-lang-id="Lainnya" data-lang-en="Others" data-lang-de="Sonstiges">Lainnya</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
