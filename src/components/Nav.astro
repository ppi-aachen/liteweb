          >
            <span data-lang-id="Kepengurusan" data-lang-en="Current Board" data-lang-de="Vorstand">Kepengurusan</span>
          </a>
          <a
            href={`${prefix}organization/ad-art.html`.replace(/\/+/g, '/')}
            class="nav-link block py-[11.5px] px-2 text-white text-[12pt] font-light transition-colors duration-200 hover:text-white"
            data-path="organization/ad-art.html"
          >
            <span data-lang-id="AD/ART PPI Aachen" data-lang-en="Bylaws" data-lang-de="Satzung">AD/ART PPI Aachen</span>
          </a>
          <a
