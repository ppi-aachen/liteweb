    <!-- Section 1: Carousel + Linktree -->
    <div class="bg-[#0161bf]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="px-0 md:px-[48px] py-6 md:py-12">
          
          <!-- Carousel -->
          <div class="overflow-hidden relative group w-full aspect-[16/9] rounded-lg shadow-md">
            <div id="carousel-track" class="flex transition-transform ease-out duration-500 h-full">
              <img src="/assets/carousel/1.webp" alt="Slide 1" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/2.webp" alt="Slide 2" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/3.webp" alt="Slide 3" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/4.webp" alt="Slide 4" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/5.webp" alt="Slide 5" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/6.webp" alt="Slide 6" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/7.webp" alt="Slide 7" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/8.webp" alt="Slide 8" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/9.webp" alt="Slide 9" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/10.webp" alt="Slide 10" class="w-full h-full object-cover flex-shrink-0" />
              <img src="/assets/carousel/11.webp" alt="Slide 11" class="w-full h-full object-cover flex-shrink-0" />
            </div>
            <div class="absolute inset-0 flex items-center justify-between p-2 md:p-4">
              <button id="carousel-prev" class="text-white hover:text-white/80 transition-colors md:p-2 md:rounded-full md:shadow md:bg-white/30 md:hover:bg-white/50 md:backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button id="carousel-next" class="text-white hover:text-white/80 transition-colors md:p-2 md:rounded-full md:shadow md:bg-white/30 md:hover:bg-white/50 md:backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
            <div class="absolute bottom-4 right-0 left-0">
              <div class="flex items-center justify-center gap-2">
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
                <div class="carousel-dot transition-all bg-white rounded-full w-3 h-3 bg-opacity-50"></div>
