                  <div class="md:w-3/5 h-64 md:h-auto relative bg-gray-200">
                    <img
                      src="images/communities/indo-aachener.png"
                      alt="Indo Aachener"
                      class="w-full h-full object-cover grayscale-0 hover:grayscale transition-all duration-500"
