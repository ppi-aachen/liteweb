---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="PPI Aachen - Arsip LPJ" prefix="../">
  <main class="flex-1 w-full min-w-0 desktop:mt-[48px]">

      
      <div class="mb-24">
        
    <div class="hero-header relative overflow-hidden text-white flex flex-col justify-center items-center text-center">
      <!-- Parallax Background Layer -->
      <div class="hero-header-bg absolute inset-0 w-full" style="background-image: url('../hero-bright.png'); height: 120%; top: -10%; z-index: 0;"></div>
    </div>
    
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="px-4 md:px-[48px] py-12">
            <h2 class="heading-2 mb-8">Arsip LPJ</h2>
            <div id="lpj-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2025/2026"
          data-url="https://drive.google.com/file/d/1JtL0zz9--6Ghbxt5BDnM7mmYfRol2dMT/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2025/2026</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2024/2025"
          data-url="https://drive.google.com/file/d/1kihZELUHJ_n4p2SapyjLLovX6Lqc4Web/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2024/2025</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2022/2024"
          data-url="https://drive.google.com/file/d/1fosB-Sxxt483uLfGNFo3HiRSkFL4gOWO/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2022/2024</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2021/2022"
          data-url="https://drive.google.com/file/d/1wRP8HHnigfMrcKprNrnT-i8m3Mt6zNHD/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2021/2022</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2020/2021"
          data-url="https://drive.google.com/file/d/1u7IYPBEHdeBnxgUWlOQyqDhs5vGVFmi-/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2020/2021</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2018/2019"
          data-url="https://drive.google.com/file/d/1BSv5HZXD5b9xFe_ZCEdUz6lkCfyi9KdB/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2018/2019</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
        <div
          class="lpj-card bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-[#0161bf] transition-all group flex items-center justify-between cursor-pointer"
          data-year="2017/2018"
          data-url="https://drive.google.com/file/d/1BVT9wmvOEdXqyKy_4VUjnBpADqr-lR7I/view?usp=sharing"
        >
          <div>
            <h3 class="heading-3 mt-0 mb-1 group-hover:text-[#0161bf] transition-colors">LPJ 2017/2018</h3>
            <p class="body-text text-sm text-gray-500 mt-0">View Document</p>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#0161bf]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
    
            </div>
          </div>
        </div>

        <!-- PDF Viewer Modal -->
        <div
          id="lpj-modal"
          class="fixed inset-0 z-50 items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition-opacity hidden"
        >
          <div class="bg-white rounded-xl shadow-2xl w-full max-w-5xl h-[85vh] relative flex flex-col animate-in fade-in zoom-in duration-200">
            <!-- Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-100">
              <h3 id="modal-lpj-title" class="font-bold text-gray-900 text-lg"></h3>
              <div class="flex items-center gap-2">
                <!-- Mobile Directly Open Button (helpful for phone layout scrolling issues) -->
                <a
                  id="modal-lpj-mobile-btn"
                  href=""
                  target="_blank"
                  rel="noopener noreferrer"
                  class="desktop:hidden px-3 py-1.5 bg-[#0161bf] hover:bg-[#004a9e] text-white text-xs font-semibold rounded-lg shadow transition-colors flex items-center gap-1"
                >
                  Buka Dokumen Langsung ↗
                </a>
                <a
                  id="modal-lpj-newtab"
                  href=""
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 text-gray-500 hover:text-[#0161bf] hover:bg-blue-50 rounded-full transition-colors"
                  title="Open in new tab"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <button
                  id="close-lpj-btn"
                  class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-full transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Content -->
            <div class="flex-grow bg-gray-100 p-2 rounded-b-xl overflow-y-auto -webkit-overflow-scrolling-touch flex flex-col">
              <iframe
                id="modal-lpj-iframe"
                src="about:blank"
                class="w-full h-full rounded-lg bg-white border-0"
                style="color-scheme: light;"
                allow="autoplay"
                title="LPJ Document"
              ></iframe>
            </div>
          </div>
        </div>

      </div>
    
    
  </main>

  <script is:inline src="/../js/arsip-lpj.js"></script>
</Layout>
