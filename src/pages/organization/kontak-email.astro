                            class="text-xl font-medium text-[#0161bf] hover:text-[#004a9e] transition-colors break-all block mb-1 last:mb-0"
                          >
                            info@ppiaachen.de
                          </a>
                        
                          <a
                            href="mailto:sekretariat@ppiaachen.de"
                            class="text-xl font-medium text-[#0161bf] hover:text-[#004a9e] transition-colors break-all block mb-1 last:mb-0"
